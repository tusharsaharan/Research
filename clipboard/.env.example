# Optional — only needed for persistent shared storage across Vercel instances.
# Without these, the app still works but uses ephemeral in-memory storage
# (fine for local dev / demo, data may reset on Vercel cold starts).
#
# To enable persistence (free):
# 1. In Vercel dashboard: Storage -> Create Database -> KV (Upstash)
# 2. Connect it to your project, then these env vars are auto-added:
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your_token_here

# Alternative names accepted by the code (all checked):
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
